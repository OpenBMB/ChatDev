# Copy this file to .env, fill in the required values, then load it with:
#   set -a; source .env; set +a
# Use shell-compatible values; quote URLs or keys containing shell characters.
# Keep .env private. See docs/SERVICES.md for setup commands and model IDs.

# --- Required: model gateway ---
# OpenAI-compatible API base URL, including /v1 where required by the provider.
# The gateway must serve the model IDs configured in this project.
LLM_BASE_URL=
LLM_API_KEY=

# --- Required: Qwen3-Embedding-4B service ---
# Use the same nonempty private key on the embedding server and client.
# Endpoint, served model ID, and tokenizer path are configured separately in
# sgar_mvp/config/embedding_release.json (created by prepare_release init).
SGAR_EMBEDDING_API_KEY=

# --- Optional: existing web services for your own tasks ---
# The bundled XBench example starts its own search and browser services.
# SearXNG root URL; the service must allow JSON results at /search.
# Browser root URL and its matching private bearer token (at least 24 characters).
# These addresses must be reachable FROM Docker containers, not host loopback.
SEARXNG_BASE_URL=
SGAR_BROWSER_BASE_URL=
SGAR_BROWSER_TOKEN=

# --- Optional: additional catalog services ---
# Needed only when enabling resources backed by these services.
EXA_API_KEY=
# Zotero Translation Server root URL.
ZOTERO_TRANSLATION_SERVER_URL=
# Hypothesis API root (including /api) and write-capable token.
HYPOTHESIS_API_URL=
HYPOTHESIS_API_TOKEN=

# --- Optional: proxy routes ---
# Leave proxy URLs empty when the corresponding connections work directly.
# Model traffic uses SGAR_MODEL_PROXY; HTTP_PROXY alone does not configure it.
SGAR_MODEL_PROXY=
# Network-enabled tools; use proxy addresses reachable from Docker containers.
SGAR_TOOL_HTTP_PROXY=
SGAR_TOOL_HTTPS_PROXY=
# Add internal tool-service hosts here when they should bypass the proxy.
SGAR_TOOL_NO_PROXY=localhost,127.0.0.1
# Terminal-Bench only: HTTP CONNECT proxy reachable from the Docker bridge.
SGAR_DOCKER_PROXY=
SGAR_NO_PROXY=localhost,127.0.0.1,::1
# Host downloads/builds and tool preparation. See docs/SERVICES.md.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1
