# SGAR reproducible multi-language runtime (RC1)
# Build from the repository root:
#   docker build -f sgar_mvp/docker/Dockerfile.runtime -t sgar-runtime:rc1 .
FROM python:3.11.9-slim-bookworm

ARG HTTP_PROXY=""
ARG HTTPS_PROXY=""
ENV HTTP_PROXY=${HTTP_PROXY} HTTPS_PROXY=${HTTPS_PROXY} \
    http_proxy=${HTTP_PROXY} https_proxy=${HTTPS_PROXY} \
    DEBIAN_FRONTEND=noninteractive \
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

LABEL org.opencontainers.image.title="SGAR RC1 tool runtime" \
      org.opencontainers.image.version="rc1" \
      org.opencontainers.image.description="Pinned execution environment for SGAR Tool readiness experiments"

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential ca-certificates clang-format curl git jq shellcheck xz-utils \
    && rm -rf /var/lib/apt/lists/*

# Node is downloaded by exact version instead of using a floating setup_*.x feed.
ARG NODE_VERSION=22.17.1
RUN curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
      -o /tmp/node.tar.xz \
    && tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 \
    && rm /tmp/node.tar.xz \
    && node --version \
    && npm --version

RUN npm install -g --no-audit --no-fund \
        eslint@10.0.1 \
        @eslint/js@10.0.1 \
        prettier@3.9.6 \
        typescript@7.0.2 \
        jest@30.4.2 \
        vitest@4.1.10 \
        stylelint@17.14.1 \
        stylelint-config-standard@40.0.0 \
        markdownlint-cli@0.49.1 \
        @stoplight/spectral-cli@6.16.3 \
        @modelcontextprotocol/server-filesystem@2026.7.10 \
        @modelcontextprotocol/server-sequential-thinking@2026.7.4

ENV NODE_PATH=/usr/local/lib/node_modules
RUN printf '{"extends":"stylelint-config-standard"}' > /opt/stylelint.config.json \
    && printf 'import js from "/usr/local/lib/node_modules/@eslint/js/src/index.js";\nexport default [js.configs.recommended];\n' \
        > /opt/eslint.config.mjs

ARG GO_VERSION=1.22.5
RUN curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" \
      | tar -C /usr/local -xz
ENV PATH="/usr/local/go/bin:/root/go/bin:/usr/local/cargo/bin:${PATH}"
RUN go install honnef.co/go/tools/cmd/staticcheck@v0.5.1

ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo \
    RUSTUP_DIST_SERVER=https://static.rust-lang.org \
    RUSTUP_UPDATE_ROOT=https://static.rust-lang.org/rustup
RUN curl -fsSL https://sh.rustup.rs \
      | sh -s -- -y --profile minimal --default-toolchain 1.79.0 \
    && rustup component add --toolchain 1.79.0 rustfmt clippy

# Repository search is pinned to the reviewed upstream release rather than the
# distribution package, whose version varies with the base image snapshot.
ARG RIPGREP_VERSION=15.2.0
RUN curl -fsSL "https://github.com/BurntSushi/ripgrep/releases/download/${RIPGREP_VERSION}/ripgrep-${RIPGREP_VERSION}-x86_64-unknown-linux-musl.tar.gz" \
      -o /tmp/ripgrep.tar.gz \
    && tar -xzf /tmp/ripgrep.tar.gz -C /tmp \
    && install -m 0755 "/tmp/ripgrep-${RIPGREP_VERSION}-x86_64-unknown-linux-musl/rg" /usr/local/bin/rg \
    && rm -rf /tmp/ripgrep.tar.gz "/tmp/ripgrep-${RIPGREP_VERSION}-x86_64-unknown-linux-musl" \
    && rg --version | head -1

RUN pip install --no-cache-dir \
        bandit==1.8.0 \
        beautifulsoup4==4.12.3 \
        black==24.10.0 \
        bleach==6.2.0 \
        chardet==5.2.0 \
        check-jsonschema==0.38.0 \
        coverage==7.6.10 \
        cryptography==44.0.0 \
        dateparser==1.4.3 \
        defusedxml==0.7.1 \
        detect-secrets==1.5.0 \
        dnspython==2.7.0 \
        duckdb==1.5.5 \
        Faker==33.1.0 \
        flake8==7.1.1 \
        genson==1.3.0 \
        gitlint-core==0.19.1 \
        gitpython==3.1.53 \
        graphql-core==3.2.5 \
        httpx==0.28.1 \
        Jinja2==3.1.5 \
        jsonschema==4.26.0 \
        langdetect==1.0.9 \
        lxml==6.1.3 \
        markdown==3.7 \
        markdown-it-py==3.0.0 \
        markdownify==0.14.1 \
        mcp==1.28.1 \
        mcp-server-git==2026.7.10 \
        mypy==1.14.1 \
        networkx==3.4.2 \
        numpy==2.1.3 \
        openpyxl==3.1.5 \
        pandas==2.2.3 \
        pdfplumber==0.11.4 \
        phonenumbers==8.13.52 \
        Pillow==11.0.0 \
        Pint==0.24.4 \
        pip-audit==2.7.3 \
        psutil==6.1.1 \
        Pygments==2.18.0 \
        pygount==1.8.0 \
        pylint==3.3.3 \
        pypdf==5.1.0 \
        pytest==8.3.4 \
        pytest-cov==6.0.0 \
        python-docx==1.1.2 \
        python-dotenv==1.0.1 \
        python-pptx==1.0.2 \
        PyYAML==6.0.2 \
        qrcode==8.0 \
        radon==6.0.1 \
        requests==2.34.2 \
        ruff==0.8.6 \
        shapely==2.0.6 \
        sqlfluff==3.3.0 \
        sqlglot==26.0.1 \
        sqlparse==0.5.3 \
        sympy==1.13.3 \
        tablib==3.7.0 \
        tomli-w==1.1.0 \
        trafilatura==2.2.0 \
        urllib3==2.8.0 \
        validators==0.34.0 \
        vulture==2.14

RUN pip freeze --all > /opt/sgar-python-lock.txt \
    && npm ls -g --depth=0 --json > /opt/sgar-node-lock.json \
    && { \
         echo "python: $(python --version 2>&1)"; \
         echo "node: $(node --version)"; \
         echo "npm: $(npm --version)"; \
         echo "go: $(go version)"; \
         echo "staticcheck: $(staticcheck -version)"; \
         echo "rustc: $(rustc --version)"; \
         echo "rustfmt: $(rustfmt --version)"; \
         echo "clippy: $(cargo clippy --version)"; \
       } > /opt/sgar-language-lock.txt

ENV HTTP_PROXY="" HTTPS_PROXY="" http_proxy="" https_proxy=""
WORKDIR /app
CMD ["python", "-V"]
