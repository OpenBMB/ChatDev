{
  "schema_version": 1,
  "policy_version": "runtime-prep-v1",
  "enabled": true,
  "trace_enabled": true,
  "mode": "derived_docker_image",
  "base_runtime_lock": "sgar_mvp/config/rc1_runtime_lock.json",
  "cache_root": ".sgar_cache/runtime_preparation",
  "derived_image_repository": "sgar-runtime-deps",
  "platform": "linux/amd64",
  "python_abi": "cp311",
  "index_url": "https://pypi.org/simple",
  "index_identity": "https://pypi.org/simple",
  "allow_same_name_fallback": true,
  "only_binary": true,
  "additive_only": true,
  "resolver_version": "python-wheel-resolver-v1",
  "build_recipe_version": "offline-derived-image-v1",
  "inspect_timeout_sec": 30,
  "resolve_timeout_sec": 300,
  "download_timeout_sec": 300,
  "build_timeout_sec": 600,
  "verify_timeout_sec": 60,
  "lock_timeout_sec": 900,
  "stale_lock_sec": 7200,
  "infrastructure_retry_limit": 2,
  "execution_network_default": "none"
}
