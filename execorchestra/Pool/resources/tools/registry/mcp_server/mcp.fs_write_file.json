{
  "manifest_version": "v2",
  "resource_id": "tool.mcp.fs_write_file.v1",
  "resource_type": "Tool",
  "status": "active",
  "capability": {
    "summary": "Create or overwrite one local text file with supplied complete contents.",
    "description": "Use when a workflow must materialize a full text artifact at an explicit path. It writes the provided content as a file; it does not perform a matched in-place edit, move a file, list folders, or search the workspace.",
    "domain_tags": [
      "filesystem",
      "file-writing",
      "artifact-creation"
    ],
    "core_primitives": [
      "write_complete_text_file",
      "create_text_artifact",
      "overwrite_file_contents"
    ],
    "operation_kinds": [
      "write_complete_text_file"
    ],
    "problem_space": "Create or replace a complete local text artifact at a known path. This is whole-file content mutation, distinct from precise replacement inside an existing file, path relocation, and all read-only filesystem inspection.",
    "execution_semantics": {
      "determinism": "deterministic",
      "side_effects": "declared",
      "effect_targets": [
        "task_workspace"
      ],
      "modalities": [
        "text"
      ]
    }
  },
  "constraint": {
    "io_signature": "Input: destination file path and complete text content. Output: JSON filesystem write result.",
    "accepted_inputs": [
      "a writable local destination path within allowed roots",
      "complete text content to persist"
    ],
    "output_shape": "JSON operation result for file creation or overwrite.",
    "limitations": [
      "does not require or preserve an old-text match for targeted edits",
      "does not read, search, move, or list files"
    ],
    "materialized_artifact_types": [
      "plaintext",
      "markdown",
      "code",
      "csv",
      "json"
    ]
  },
