{
  "manifest_version": "v2",
  "resource_id": "tool.mcp.git_diff_staged.v1",
  "resource_type": "Tool",
  "status": "active",
  "capability": {
    "summary": "Show the patch between the Git index and the last committed revision.",
    "description": "Use to review changes that have already been staged for a possible commit. It reports the index diff; it does not show unstaged worktree edits, stage files, create commits, or change repository state.",
    "domain_tags": [
      "git",
      "staged-diff",
      "change-review"
    ],
    "core_primitives": [
      "inspect_index_diff",
      "review_staged_patch",
      "compare_staged_changes"
    ],
    "problem_space": "Review the patch formed by staged Git index changes. This is staged-change inspection, distinct from unstaged worktree diff, status summary, commit creation, and staging mutation."
  },
  "constraint": {
    "io_signature": "Input: local Git repository path. Output: JSON or text patch for staged changes.",
    "accepted_inputs": [
      "a local directory containing a Git repository"
    ],
    "output_shape": "patch representation of index changes relative to HEAD.",
    "limitations": [
      "does not include unstaged working-tree edits",
      "does not stage, commit, or modify repository files"
    ]
  },
  "io": {
    "input_contract": [
      {
        "name": "repo_path",
        "kind": "string",
        "required": true,
        "cli_position": 1
      }
    ],
    "output_contract": {
      "artifact_type": "text",
      "description": "Staged diff via MCP git server"
    }
  },
  "routing": {
    "family": "git-change-inspection",
    "intent_tags": [
      "show staged diff",
      "review indexed changes",
      "see what will be committed"
    ],
    "negative_intents": [
      "show unstaged diff",
      "stage files",
      "create a commit"
    ]
  },
