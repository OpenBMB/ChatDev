{
  "manifest_version": "v2",
  "resource_id": "tool.mcp.fs_get_file_info.v1",
  "resource_type": "Tool",
  "status": "active",
  "capability": {
    "summary": "Inspect metadata for one known local file or directory path without reading or changing its contents.",
    "description": "Use to obtain filesystem attributes of a specified path, such as whether it exists, its type, size, and timestamps. It is a metadata inspection operation, not a content reader, directory enumerator, pattern search, or mutation tool.",
    "domain_tags": [
      "filesystem",
      "path-metadata",
      "file-inspection"
    ],
    "core_primitives": [
      "inspect_path_metadata",
      "identify_file_or_directory",
      "read_filesystem_attributes"
    ],
    "problem_space": "Inspect metadata for a known filesystem path before choosing a later operation. It answers properties of one file or directory, distinct from listing children, traversing a tree, reading textual content, or modifying the path."
  },
  "constraint": {
    "io_signature": "Input: one local file or directory path. Output: JSON metadata describing that path.",
    "accepted_inputs": [
      "an explicit local file or directory path within allowed roots"
    ],
    "output_shape": "JSON path metadata such as file type, size, and timestamps.",
    "limitations": [
      "does not return file contents or child entries",
      "does not search or alter the filesystem"
    ]
  },
  "io": {
    "input_contract": [
      {
        "name": "path",
        "kind": "string",
        "required": true,
        "cli_position": 1
      }
    ],
    "output_contract": {
      "artifact_type": "json",
      "description": "File/dir metadata via MCP filesystem server",
      "json_schema": {
        "description": "Native JSON representation only; no field or task-delivery guarantee.",
