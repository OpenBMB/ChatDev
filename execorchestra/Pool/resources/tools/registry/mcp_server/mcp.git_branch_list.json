  "resource_id": "tool.mcp.git_branch_list.v1",
  "resource_type": "Tool",
  "status": "active",
  "capability": {
    "summary": "List local branch names in a specified Git repository.",
    "description": "Use to inspect which local branches exist before selecting or creating one. It is branch inventory only; it does not switch branches, create branches, show commits, stage files, or mutate repository state.",
    "domain_tags": [
      "git",
      "branch-inspection",
      "version-control"
    ],
    "core_primitives": [
      "list_local_branches",
      "inspect_branch_names",
      "identify_branch_context"
    ],
    "problem_space": "Inspect local branch names in a known Git repository. This is branch discovery, distinct from branch creation, commit-history inspection, worktree status, staging, and repository mutation."
  },
  "constraint": {
    "io_signature": "Input: local Git repository path. Output: JSON list of local branch names.",
    "accepted_inputs": [
      "a local directory containing a Git repository"
    ],
    "output_shape": "JSON collection of local branch records or names.",
    "limitations": [
      "does not create, delete, switch, or merge branches",
      "does not show commit history or working-tree changes"
    ]
  },
  "io": {
