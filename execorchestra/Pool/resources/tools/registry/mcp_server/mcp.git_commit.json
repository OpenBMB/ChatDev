{
  "manifest_version": "v2",
  "resource_id": "tool.mcp.git_commit.v1",
  "resource_type": "Tool",
  "status": "active",
  "capability": {
    "execution_semantics": {
      "side_effects": "declared",
      "effect_targets": [
        "task_workspace"
      ]
    },
    "summary": "Create a Git commit from the repository's already staged changes using a supplied message.",
    "description": "Use to record the current Git index as a new repository revision after staging is complete. It creates a history entry; it does not choose files to stage, inspect a diff, create a branch, or alter unstaged changes.",
    "domain_tags": [
      "git",
      "commit-creation",
      "version-control"
    ],
    "core_primitives": [
      "commit_staged_changes",
      "record_repository_revision",
      "write_commit_message"
    ],
    "problem_space": "Record already staged repository changes as one Git commit with a supplied message. This is history mutation, distinct from staging paths, inspecting status or diffs, and creating a branch."
  },
  "constraint": {
    "io_signature": "Input: local Git repository path and commit message. Output: JSON mutation invocation receipt.",
    "accepted_inputs": [
      "a local Git repository with staged changes",
      "a non-empty commit message"
    ],
    "output_shape": "JSON invocation receipt with status, operation, and completed; a failed operation includes error_code. Verify the requested workspace state separately.",
    "limitations": [
      "does not stage files or select unstaged changes",
      "does not create branches or display repository history"
    ]
  },
  "io": {
    "input_contract": [
      {
        "name": "repo_path",
        "kind": "string",
        "required": true,
        "cli_position": 1
      },
      {
        "name": "message",
        "kind": "string",
        "required": true,
        "cli_position": 2
      }
    ],
    "output_contract": {
      "artifact_type": "json",
      "description": "MCP-confirmed mutation invocation receipt; the requested final state must be checked separately.",
      "schema": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string"
              },
              "status": {
                "const": "success"
              },
              "completed": {
                "const": true
              }
            },
            "required": [
              "status",
              "operation",
              "completed"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string"
              },
              "status": {
                "const": "error"
              },
              "completed": {
                "const": false
              },
              "error_code": {
                "enum": [
                  "mcp_operation_failed",
                  "mcp_transport_failure"
                ]
              },
              "error_type": {
                "type": "string"
              }
            },
            "required": [
              "status",
              "operation",
              "completed",
              "error_code"
            ],
            "additionalProperties": false
          }
        ]
      },
      "result_status": {
        "payload_path": "status",
        "success_values": [
          "success"
        ],
        "failure_values": [
          "error"
        ]
      }
    }
  },
  "routing": {
    "family": "git-history-mutation",
    "intent_tags": [
      "create a Git commit",
      "commit staged changes",
      "record a repository revision"
    ],
    "negative_intents": [
      "stage files",
      "show git status",
      "create a branch"
    ]
  },
