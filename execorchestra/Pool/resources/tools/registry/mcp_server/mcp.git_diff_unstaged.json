{
  "manifest_version": "v2",
  "resource_id": "tool.mcp.git_diff_unstaged.v1",
  "resource_type": "Tool",
  "status": "active",
  "capability": {
    "summary": "Show uncommitted working-tree changes that have not been staged in Git.",
    "description": "Use to review edits still outside the Git index before deciding whether to stage them. It compares the working tree to the index; it does not show only staged changes, stage files, commit changes, or mutate the repository.",
    "domain_tags": [
      "git",
      "unstaged-diff",
      "change-review"
    ],
    "core_primitives": [
      "inspect_worktree_diff",
      "review_unstaged_patch",
      "compare_unstaged_changes"
    ],
    "problem_space": "Review modifications in the Git working tree that have not entered the staging index. This is unstaged-change inspection, distinct from reviewing an index diff, status summary, staging, and committing."
  },
  "constraint": {
    "io_signature": "Input: local Git repository path. Output: JSON or text patch for unstaged working-tree changes.",
    "accepted_inputs": [
      "a local directory containing a Git repository"
    ],
    "output_shape": "patch representation of working-tree changes relative to the index.",
    "limitations": [
      "does not show only staged index changes",
      "does not stage, commit, or modify repository files"
    ]
  },
  "io": {
    "input_contract": [
      {
        "name": "repo_path",
        "kind": "string",
        "required": true,
        "cli_position": 1
      }
    ],
    "output_contract": {
      "artifact_type": "text",
      "description": "Unstaged diff via MCP git server"
    }
  },
  "routing": {
    "family": "git-change-inspection",
    "intent_tags": [
      "show unstaged diff",
      "review uncommitted edits",
      "see working tree changes"
    ],
    "negative_intents": [
      "show staged diff",
      "stage files",
      "create a commit"
    ]
  },
