{
  "manifest_version": "v2",
  "resource_id": "tool.mcp.fs_list_directory.v1",
  "resource_type": "Tool",
  "status": "active",
  "capability": {
    "summary": "List the immediate files and folders directly contained in one local directory.",
    "description": "Use to enumerate one directory's direct children when the root path is known. It is a one-level listing for quick inspection; it does not recursively build a tree, search by name or content, read a selected file, or mutate the filesystem.",
    "domain_tags": [
      "filesystem",
      "directory-listing",
      "workspace-inspection"
    ],
    "core_primitives": [
      "list_immediate_directory_entries",
      "enumerate_files_and_folders",
      "inspect_directory_children"
    ],
    "problem_space": "Enumerate the immediate entries of a known local directory. This is shallow filesystem discovery, distinct from recursive hierarchy traversal, content or filename search, reading a known file, and all filesystem writes."
  },
  "constraint": {
    "io_signature": "Input: one local directory path. Output: text listing of immediate file and folder entries.",
    "accepted_inputs": [
      "an existing local directory path within allowed roots"
    ],
    "output_shape": "text list of immediate child names and paths.",
    "limitations": [
      "does not recurse into descendant directories",
      "does not search file names, inspect content, or modify paths"
    ]
  },
  "io": {
    "input_contract": [
      {
        "name": "path",
        "kind": "directory_path",
        "required": true,
        "cli_position": 1
      }
    ],
    "output_contract": {
      "artifact_type": "text",
      "description": "List a directory via MCP filesystem server"
    }
  },
  "routing": {
