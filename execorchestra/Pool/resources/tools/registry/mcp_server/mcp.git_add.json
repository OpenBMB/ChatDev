{
  "manifest_version": "v2",
  "resource_id": "tool.mcp.git_add.v1",
  "resource_type": "Tool",
  "status": "active",
  "capability": {
    "execution_semantics": {
      "side_effects": "declared",
      "effect_targets": [
        "task_workspace"
      ]
    },
    "summary": "Stage specified working-tree files in a local Git repository for a later commit.",
    "description": "Use to add an explicit set of changed paths to the Git index. It prepares selected changes for review or commit; it does not create a commit, inspect repository status, create a branch, or show a diff.",
    "domain_tags": [
      "git",
      "staging",
      "version-control"
    ],
    "core_primitives": [
      "stage_selected_paths",
      "update_git_index",
      "prepare_commit"
    ],
    "problem_space": "Add explicit local repository paths to the Git staging area. This is index management, distinct from recording a commit, listing branch names, inspecting diffs, or reporting worktree status."
  },
  "constraint": {
    "io_signature": "Input: repository path and comma-separated file paths. Output: JSON mutation invocation receipt.",
    "accepted_inputs": [
      "a local Git repository path",
      "one or more paths relative to that repository"
    ],
    "output_shape": "JSON invocation receipt with status, operation, and completed; a failed operation includes error_code. Verify the requested workspace state separately.",
    "limitations": [
      "does not create a commit",
      "does not stage unspecified files or inspect a diff"
    ]
  },
  "io": {
    "input_contract": [
      {
        "name": "repo_path",
        "kind": "string",
        "required": true,
        "cli_position": 1
      },
      {
        "name": "files",
        "kind": "string",
        "required": true,
        "cli_position": 2
      }
    ],
    "output_contract": {
      "artifact_type": "json",
      "description": "MCP-confirmed mutation invocation receipt; the requested final state must be checked separately.",
      "schema": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string"
              },
              "status": {
                "const": "success"
              },
              "completed": {
                "const": true
              }
            },
            "required": [
              "status",
              "operation",
              "completed"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string"
              },
              "status": {
                "const": "error"
              },
              "completed": {
                "const": false
              },
              "error_code": {
                "enum": [
                  "mcp_operation_failed",
                  "mcp_transport_failure"
                ]
              },
              "error_type": {
                "type": "string"
              }
            },
            "required": [
              "status",
              "operation",
              "completed",
              "error_code"
            ],
            "additionalProperties": false
          }
        ]
      },
      "result_status": {
        "payload_path": "status",
        "success_values": [
          "success"
        ],
        "failure_values": [
          "error"
        ]
      }
    }
  },
  "routing": {
