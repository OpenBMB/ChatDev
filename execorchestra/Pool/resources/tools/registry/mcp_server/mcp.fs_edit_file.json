{
  "manifest_version": "v2",
  "resource_id": "tool.mcp.fs_edit_file.v1",
  "resource_type": "Tool",
  "status": "active",
  "capability": {
    "execution_semantics": {
      "side_effects": "declared",
      "effect_targets": [
        "task_workspace"
      ],
      "determinism": "deterministic"
    },
    "summary": "Replace one exact text fragment with new text inside an existing local file.",
    "description": "Use when a known text file needs an in-place, targeted replacement: provide its path, the exact old text, and replacement text. The tool edits an existing file by matching text; it is not a general file reader, file creator, rename operation, or pattern search across a workspace.",
    "domain_tags": [
      "filesystem",
      "text-replacement",
      "source-editing"
    ],
    "core_primitives": [
      "match_existing_text",
      "replace_text_fragment",
      "edit_existing_file"
    ],
    "problem_space": "Apply a precise text replacement to one known existing local file. This is targeted in-place mutation that requires the old fragment, distinct from writing an entire new file, reading content without changes, moving paths, or searching unknown files."
  },
  "constraint": {
    "io_signature": "Input: existing file path, exact old text, and replacement text. Output: JSON mutation invocation receipt.",
    "accepted_inputs": [
      "an existing editable local text-file path",
      "an exact text fragment currently present in that file",
      "replacement text"
    ],
    "output_shape": "JSON invocation receipt with status, operation, and completed; a failed operation includes error_code. Verify the requested workspace state separately.",
    "limitations": [
      "does not create a missing file or overwrite an entire file without a text match",
      "does not locate unknown files or read files without changing them"
    ]
  },
  "io": {
    "input_contract": [
      {
        "name": "path",
        "kind": "string",
        "required": true,
        "cli_position": 1
      },
      {
        "name": "old_text",
        "kind": "string",
        "required": true,
        "cli_position": 2
      },
      {
        "name": "new_text",
        "kind": "string",
        "required": true,
        "cli_position": 3
      }
    ],
    "output_contract": {
      "artifact_type": "json",
      "description": "MCP-confirmed mutation invocation receipt; the requested final state must be checked separately.",
      "schema": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string"
              },
              "status": {
                "const": "success"
              },
              "completed": {
                "const": true
              }
            },
            "required": [
              "status",
              "operation",
              "completed"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string"
              },
              "status": {
                "const": "error"
              },
              "completed": {
                "const": false
              },
              "error_code": {
                "enum": [
                  "mcp_operation_failed",
                  "mcp_transport_failure"
                ]
              },
              "error_type": {
                "type": "string"
              }
            },
            "required": [
              "status",
              "operation",
              "completed",
              "error_code"
            ],
            "additionalProperties": false
          }
        ]
      },
      "result_status": {
        "payload_path": "status",
        "success_values": [
          "success"
        ],
        "failure_values": [
          "error"
        ]
      }
    }
  },
  "routing": {
