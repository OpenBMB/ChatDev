{
  "manifest_version": "v2",
  "resource_id": "tool.mcp.git_status.v1",
  "resource_type": "Tool",
  "status": "active",
  "capability": {
    "summary": "Report staged, unstaged, and untracked state for a local Git working tree.",
    "description": "Use to obtain a concise repository status summary before deciding what to stage, review, or commit. It reports the current worktree and index state; it does not display patch content, stage paths, create commits, or change branches.",
    "domain_tags": [
      "git",
      "worktree-status",
      "repository-inspection"
    ],
    "core_primitives": [
      "inspect_worktree_status",
      "identify_staged_unstaged_untracked",
      "summarize_repository_state"
    ],
    "problem_space": "Summarize the current state of a local Git repository, including staged, unstaged, and untracked paths. This is state inspection, distinct from patch-level diff review, staging, committing, or branch mutation."
  },
  "constraint": {
    "io_signature": "Input: local Git repository path. Output: text or JSON summary of worktree and index status.",
    "accepted_inputs": [
      "a local directory containing a Git repository"
    ],
    "output_shape": "repository status entries grouped by staging state.",
    "limitations": [
      "does not display full file patches",
      "does not stage, commit, switch branches, or alter files"
    ]
  },
  "io": {
    "input_contract": [
      {
        "name": "repo_path",
        "kind": "directory_path",
        "required": true,
        "cli_position": 1
      }
    ],
    "output_contract": {
      "artifact_type": "text",
      "description": "Working-tree status via MCP git server"
    }
  },
  "routing": {
    "family": "git-worktree-inspection",
    "intent_tags": [
      "show git status",
      "inspect staged unstaged and untracked files",
      "summarize repository state"
    ],
    "negative_intents": [
      "show a diff patch",
      "stage files",
      "create a commit"
    ]
  },
