{
  "manifest_version": "v2",
  "resource_id": "tool.mcp.fs_read_multiple.v1",
  "resource_type": "Tool",
  "status": "active",
  "capability": {
    "summary": "Read textual contents from several explicitly named local files in one operation.",
    "description": "Use when a workflow already has a bounded set of file paths and needs all their text together. It reads supplied paths only; it does not discover files, traverse directories, search patterns, or modify content.",
    "domain_tags": [
      "filesystem",
      "multi-file-reading",
      "source-inspection"
    ],
    "core_primitives": [
      "read_multiple_text_files",
      "aggregate_known_file_contents",
      "batch_content_loading"
    ],
    "problem_space": "Collect text from several known local files in one call. This is bounded multi-file content access, distinct from one-file reading, recursive traversal, filename/content search, and all writes."
  },
  "constraint": {
    "io_signature": "Input: comma-separated local text-file paths. Output: JSON collection of text contents by path.",
    "accepted_inputs": [
      "one or more existing readable local text-file paths within allowed roots"
    ],
    "output_shape": "JSON mapping or collection of requested paths and their text contents.",
    "limitations": [
      "does not locate files by a pattern or scan a directory",
      "does not edit files or read arbitrary binary documents"
    ]
  },
  "io": {
    "input_contract": [
      {
        "name": "paths",
        "kind": "string",
        "required": true,
        "cli_position": 1
      }
    ],
    "output_contract": {
      "artifact_type": "json",
      "description": "Read multiple files at once via MCP filesystem server",
      "json_schema": {
        "description": "Native JSON representation only; no field or task-delivery guarantee.",
        "type": [
          "object",
          "array",
          "string",
          "number",
          "boolean",
          "null"
        ]
      },
      "native_json_contract_scope": "value_only"
    }
  },
