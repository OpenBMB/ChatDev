{
  "manifest_version": "v2",
  "resource_id": "tool.mcp.sequential_thinking.v1",
  "resource_type": "Tool",
  "status": "active",
  "capability": {
    "summary": "Record a bounded, explicit sequence of reasoning steps for one supplied problem statement.",
    "description": "Use when a workflow needs a structured thought trace to decompose, revise, or check a reasoning process. It organizes supplied reasoning through sequential steps; it does not execute code, inspect local files, retrieve external data, or guarantee factual grounding.",
    "domain_tags": [
      "reasoning",
      "problem-decomposition",
      "thought-tracing"
    ],
    "core_primitives": [
      "decompose_problem",
      "record_reasoning_step",
      "revise_thought_sequence"
    ],
    "problem_space": "Structure a bounded sequence of explicit reasoning steps for an already supplied problem. This is deliberation support, distinct from deterministic computation, code execution, filesystem access, web research, or external-data retrieval."
  },
  "constraint": {
    "io_signature": "Input: one problem or thought string. Output: JSON sequential-thinking record.",
    "accepted_inputs": [
      "a textual problem statement or intermediate reasoning step"
    ],
    "output_shape": "JSON thought record with step position and continuation state.",
    "limitations": [
      "does not execute tools, code, or mathematical solvers",
      "does not retrieve files, web content, APIs, or independent evidence"
    ]
  },
  "io": {
    "input_contract": [
      {
        "name": "problem",
        "kind": "string",
        "required": true,
        "cli_position": 1
      }
    ],
    "output_contract": {
      "artifact_type": "json",
      "description": "Structured step-by-step reasoning (MCP)",
      "json_schema": {
        "description": "Native JSON representation only; no field or task-delivery guarantee.",
