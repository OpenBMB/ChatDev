{
  "manifest_version": "v2",
  "resource_id": "tool.mcp.git_log.v1",
  "resource_type": "Tool",
  "status": "active",
  "capability": {
    "summary": "List recent commits from a local Git repository, optionally limited by count.",
    "description": "Use to inspect repository revision history as a sequence of commits. It lists history summaries; it does not show a specific commit patch, compare working changes, create commits, or mutate branches.",
    "domain_tags": [
      "git",
      "commit-history",
      "history-inspection"
    ],
    "core_primitives": [
      "list_recent_commits",
      "inspect_revision_history",
      "limit_commit_history"
    ],
    "problem_space": "Inspect a chronological list of commits in a known local Git repository. This is history listing, distinct from showing one revision's full patch, reviewing diffs, and all Git mutations."
  },
  "constraint": {
    "io_signature": "Input: local Git repository path and optional maximum commit count. Output: JSON commit-history list.",
    "accepted_inputs": [
      "a local directory containing a Git repository",
      "an optional positive commit-count limit"
    ],
    "output_shape": "JSON collection of commit summary records.",
    "limitations": [
      "does not show a selected commit's complete patch",
      "does not alter branches, files, index, or history"
    ]
  },
  "io": {
    "input_contract": [
      {
        "name": "repo_path",
        "kind": "string",
        "required": true,
        "cli_position": 1
      },
      {
        "name": "max_count",
        "kind": "string",
        "required": false,
        "cli_position": 2
      }
    ],
    "output_contract": {
      "artifact_type": "json",
      "description": "Commit log via MCP git server",
      "json_schema": {
        "description": "Native JSON representation only; no field or task-delivery guarantee.",
        "type": [
          "object",
          "array",
          "string",
          "number",
          "boolean",
          "null"
        ]
      },
      "native_json_contract_scope": "value_only"
    }
  },
  "routing": {
    "family": "git-history-inspection",
    "intent_tags": [
      "list recent commits",
      "show Git log",
      "inspect commit history"
    ],
    "negative_intents": [
      "show one commit patch",
      "show working-tree diff",
      "create a commit"
    ]
  },
  "execution": {
