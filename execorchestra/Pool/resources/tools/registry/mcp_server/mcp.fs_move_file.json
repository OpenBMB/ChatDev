{
  "manifest_version": "v2",
  "resource_id": "tool.mcp.fs_move_file.v1",
  "resource_type": "Tool",
  "status": "active",
  "capability": {
    "execution_semantics": {
      "side_effects": "declared",
      "effect_targets": [
        "task_workspace"
      ],
      "determinism": "deterministic"
    },
    "summary": "Move or rename one local file from an explicit source path to an explicit destination path.",
    "description": "Use when an existing file must be relocated or renamed while preserving its contents. It performs a path-level move; it does not copy content, edit text in place, inspect a directory, or create a file from supplied text.",
    "domain_tags": [
      "filesystem",
      "file-relocation",
      "path-mutation"
    ],
    "core_primitives": [
      "move_file",
      "rename_file",
      "relocate_path"
    ],
    "problem_space": "Relocate or rename a known existing local file using a source and destination path. This is path mutation, distinct from editing file content, writing a new file, listing directories, and searching for unknown files."
  },
  "constraint": {
    "io_signature": "Input: existing source file path and destination path. Output: JSON mutation invocation receipt.",
    "accepted_inputs": [
      "an existing source file path",
      "a destination path within allowed filesystem roots"
    ],
    "output_shape": "JSON invocation receipt with status, operation, and completed; a failed operation includes error_code. Verify the requested workspace state separately.",
    "limitations": [
      "does not edit the file's contents",
      "does not copy a file or create a file from supplied text"
    ]
  },
  "io": {
    "input_contract": [
      {
        "name": "source",
        "kind": "string",
        "required": true,
        "cli_position": 1
      },
      {
        "name": "destination",
        "kind": "string",
        "required": true,
        "cli_position": 2
      }
    ],
    "output_contract": {
      "artifact_type": "json",
      "description": "MCP-confirmed mutation invocation receipt; the requested final state must be checked separately.",
      "schema": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string"
              },
              "status": {
                "const": "success"
              },
              "completed": {
                "const": true
              }
            },
            "required": [
              "status",
              "operation",
              "completed"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string"
              },
              "status": {
                "const": "error"
              },
              "completed": {
                "const": false
              },
              "error_code": {
                "enum": [
                  "mcp_operation_failed",
                  "mcp_transport_failure"
                ]
              },
              "error_type": {
                "type": "string"
              }
            },
            "required": [
              "status",
              "operation",
              "completed",
              "error_code"
            ],
            "additionalProperties": false
          }
        ]
      },
      "result_status": {
        "payload_path": "status",
        "success_values": [
          "success"
        ],
        "failure_values": [
          "error"
        ]
      }
    }
  },
