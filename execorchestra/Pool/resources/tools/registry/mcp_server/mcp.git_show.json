{
  "manifest_version": "v2",
  "resource_id": "tool.mcp.git_show.v1",
  "resource_type": "Tool",
  "status": "active",
  "capability": {
    "summary": "Show the metadata and patch for one specified Git revision.",
    "description": "Use when a workflow needs the details of a known commit or revision, including its message and changed content. It inspects one selected revision; it does not list history, compare uncommitted work, or mutate the repository.",
    "domain_tags": [
      "git",
      "revision-inspection",
      "commit-patch"
    ],
    "core_primitives": [
      "show_selected_revision",
      "inspect_commit_patch",
      "read_commit_metadata"
    ],
    "problem_space": "Inspect a named Git revision and its patch in a known local repository. This is single-revision inspection, distinct from listing commit history, staged or unstaged diff review, and repository mutation."
  },
  "constraint": {
    "io_signature": "Input: local Git repository path and revision identifier. Output: text or JSON commit metadata and patch.",
    "accepted_inputs": [
      "a local directory containing a Git repository",
      "a commit hash, tag, or revision expression"
    ],
    "output_shape": "commit details with patch content for the selected revision.",
    "limitations": [
      "does not list a sequence of commits",
      "does not show uncommitted working-tree changes or mutate history"
    ]
  },
  "io": {
    "input_contract": [
      {
        "name": "repo_path",
        "kind": "string",
        "required": true,
        "cli_position": 1
      },
      {
        "name": "revision",
        "kind": "string",
        "required": true,
        "cli_position": 2
      }
    ],
    "output_contract": {
      "artifact_type": "text",
      "description": "Show a commit via MCP git server"
    }
  },
  "routing": {
    "family": "git-history-inspection",
    "intent_tags": [
      "show a Git commit",
      "inspect a commit patch",
      "view a specific revision"
    ],
    "negative_intents": [
      "list commit history",
      "show unstaged changes",
      "create a commit"
    ]
  },
