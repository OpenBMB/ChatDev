{
  "manifest_version": "v2",
  "resource_id": "tool.mcp.fs_read_file.v1",
  "resource_type": "Tool",
  "status": "active",
  "capability": {
    "summary": "Read the complete textual contents of one known local file without modifying it.",
    "description": "Use when a workflow already knows the path of one text file and needs its contents for analysis or a later operation. It reads one file only; it does not search for files, enumerate directories, parse binary documents, or write changes.",
    "domain_tags": [
      "filesystem",
      "text-file-reading",
      "source-inspection"
    ],
    "core_primitives": [
      "read_text_file",
      "load_file_contents",
      "inspect_known_file"
    ],
    "problem_space": "Load the text contents of one explicit local file. This is single-file content access, distinct from finding files by a pattern, reading multiple files, listing folders, editing content, and extracting specialized document formats.",
    "execution_semantics": {
      "determinism": "deterministic",
      "side_effects": "none",
      "effect_targets": [],
      "modalities": [
        "text"
      ]
    }
  },
  "constraint": {
    "io_signature": "Input: one local text-file path. Output: text contents of that file.",
    "accepted_inputs": [
      "an existing readable local text-file path within allowed roots"
    ],
    "output_shape": "plain text file content.",
    "limitations": [
      "does not discover unknown files or search file contents",
      "does not modify files or parse binary document formats"
    ]
  },
  "io": {
    "input_contract": [
      {
        "name": "path",
        "kind": "file_path",
        "required": true,
        "cli_position": 1,
        "content_encoding": "utf-8"
      }
    ],
    "output_contract": {
      "artifact_type": "text",
      "description": "Read a text file's contents via MCP filesystem server"
    }
  },
  "routing": {
    "family": "filesystem-content-read",
    "intent_tags": [
      "read a known text file",
      "inspect source file contents",
      "load one file's text"
    ],
    "negative_intents": [
