      "determinism": "deterministic"
    },
    "summary": "Create one local directory at an explicit path and return the filesystem operation result.",
    "description": "Use when a workflow must create a named folder in an allowed local workspace before writing files into it. The operation creates a directory only; it does not enumerate existing entries, read files, or write file contents.",
    "domain_tags": [
      "filesystem",
      "directory-creation",
      "workspace-setup"
    ],
    "core_primitives": [
      "create_directory",
      "create_parent_folder",
      "prepare_output_location"
    ],
    "problem_space": "Create a required local output directory from a known path. This is filesystem mutation for workspace setup, distinct from listing directory entries, recursively displaying a tree, searching for files, or writing a file's contents."
  },
  "constraint": {
    "io_signature": "Input: one directory path string. Output: JSON mutation invocation receipt.",
    "accepted_inputs": [
      "an explicit local directory path within the tool's allowed filesystem roots"
    ],
    "output_shape": "JSON invocation receipt with status, operation, and completed; a failed operation includes error_code. Verify the requested workspace state separately.",
    "limitations": [
      "does not list or inspect existing directory contents",
      "does not create, overwrite, or edit a file"
    ]
  },
