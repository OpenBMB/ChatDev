{
  "manifest_version": "v2",
  "resource_id": "tool.browsertrix_crawl.v1",
  "resource_type": "Tool",
  "status": "active",
  "capability": {
    "summary": "Capture a public webpage with Browsertrix Crawler into replayable web-archive artifacts",
    "description": "SGAR task-container adapter invoking upstream Browsertrix Crawler. Browsertrix performs browser execution and capture; the adapter only bounds invocation and reports produced artifacts.",
    "domain_tags": [
      "research",
      "web_archive",
      "browser"
    ],
    "core_primitives": [
      "crawl_public_url",
      "capture_browser_network_activity",
      "produce_warc_or_wacz_artifacts"
    ],
    "problem_space": "High-fidelity capture of a specified public URL for later evidence review; not web search, citation normalization, or arbitrary browser interaction.",
    "operation_kinds": [
      "browser_capture"
    ]
  },
  "constraint": {
    "io_signature": "Input public URL and task-container output directory; output produced WARC/WACZ and crawler logs.",
    "accepted_inputs": [
      "public HTTP(S) URL"
    ],
    "output_shape": "JSON artifact receipt with produced files and crawler streams.",
    "limitations": [
      "requires browsertrix-crawler in the supplied task image",
      "browser execution can create substantial CPU/memory/disk/network load",
      "site JavaScript, robots, CAPTCHA and authentication can prevent complete capture",
      "proxy credentials are not configured by default"
    ],
    "artifact_output": [
      "warc",
      "wacz",
      "json"
    ]
  },
  "io": {
    "input_contract": [
      {
        "name": "url",
        "kind": "string",
        "required": true,
        "cli_position": 1
      },
      {
        "name": "output_dir",
        "kind": "directory",
        "required": true,
        "cli_position": 2
      }
    ],
    "output_contract": {
      "artifact_type": "json",
      "description": "Capture receipt referencing Browsertrix archive artifacts.",
