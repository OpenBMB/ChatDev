{
  "manifest_version": "v2",
  "resource_id": "tool.archive_zip_extract.v1",
  "resource_type": "Tool",
  "status": "active",
  "capability": {
    "summary": "Safely extract every regular file from one ZIP archive into an explicit task-workspace directory.",
    "description": "Uses Python zipfile to validate all archive members before extraction, rejects traversal and symbolic links, and returns relative extracted-file names plus aggregate size facts.",
    "domain_tags": [
      "archive",
      "zip",
      "file-extraction"
    ],
    "core_primitives": [
      "extract_zip_archive"
    ],
    "operation_kinds": [
      "extract_zip_archive"
    ],
    "problem_space": "Deterministic unpacking of ZIP attachments so downstream tools or agents can inspect their contained files.",
    "execution_semantics": {
      "determinism": "deterministic",
      "side_effects": "declared",
      "effect_targets": [
        "task_workspace"
      ],
      "modalities": [
        "archive",
        "file"
      ]
    }
  },
  "constraint": {
    "io_signature": "Input: ZIP file path and destination directory inside the task workspace. Output: typed JSON receipt listing extracted relative file names and aggregate byte count.",
    "accepted_inputs": [
      "a readable, non-encrypted ZIP archive",
      "an output directory within SGAR_WORKSPACE_ROOT"
    ],
    "artifact_input": [
      "zip",
      "archive",
      "file"
    ],
    "artifact_output": [
      "json"
    ],
    "output_shape": "Success contains status, tool, extracted_files, extracted_file_count, and total_uncompressed_bytes. Unsafe, malformed, oversized, or unreadable archives return a typed error envelope and non-zero exit.",
    "limitations": [
      "supports ZIP archives only",
      "rejects symbolic links, path traversal, more than 10000 members, or more than 1 GiB declared uncompressed content",
      "does not decrypt password-protected members",
      "returns a receipt; downstream inspection uses the declared output directory"
    ]
  },
  "io": {
    "input_contract": [
      {
        "name": "archive_path",
        "kind": "file_path",
        "artifact_types": [
          "zip",
          "archive"
        ],
        "extensions": [
          ".zip"
        ],
        "required": true,
        "cli_position": 1
      },
      {
        "name": "output_directory",
        "kind": "directory_path",
        "required": true,
        "cli_position": 2
      }
    ],
    "output_contract": {
      "artifact_type": "json",
      "description": "Typed ZIP extraction receipt.",
      "json_schema": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "success"
              },
              "tool": {
                "const": "python-zipfile"
              },
              "extracted_files": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "extracted_file_count": {
                "type": "integer",
                "minimum": 0
              },
              "total_uncompressed_bytes": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "status",
              "tool",
              "extracted_files",
              "extracted_file_count",
              "total_uncompressed_bytes"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "error"
              },
              "tool": {
                "const": "python-zipfile"
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "status",
              "tool",
              "message"
            ],
            "additionalProperties": false
          }
        ]
      },
      "result_status": {
        "payload_path": "status",
        "success_values": [
          "success"
        ],
        "failure_values": [
          "error"
        ]
      }
    }
  },
  "routing": {
    "family": "zip-archive-extraction",
