      "return_validation_diagnostics"
    ],
    "problem_space": "Offline contract validation of file-backed JSON/YAML instances; not schema inference, remote schema retrieval, data repair, or general linting."
  },
  "constraint": {
    "io_signature": "Input local schema path and local instance paths; output validity, diagnostics and upstream exit code.",
