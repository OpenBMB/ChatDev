  "capability": {
    "summary": "Validate local JSON or YAML with check-jsonschema 0.38.0",
    "description": "Thin SGAR adapter that invokes the upstream check-jsonschema CLI against one local schema and one or more local instances without selecting remote builtin schemas.",
