  "capability": {
    "summary": "Normalize citation metadata through Zotero Translation Server",
    "description": "SGAR adapter over upstream Zotero Translation Server identifier and webpage translation APIs.",
    "domain_tags": [
      "research",
      "citation",
      "metadata"
    ],
    "core_primitives": [
      "resolve_identifier_metadata",
      "normalize_citation_items",
      "return_zotero_json"
    ],
    "problem_space": "Citation metadata normalization for public webpages and scholarly identifiers; not web search, evidence capture, quote extraction, or source hashing."
  },
  "constraint": {
    "io_signature": "Input public URL or DOI/ISBN/PMID/arXiv identifier; output Zotero JSON items or translator diagnostics.",
    "accepted_inputs": [
      "public URL or supported scholarly identifier"
    ],
    "output_shape": "JSON normalized citation item envelope.",
    "limitations": [
      "requires local/self-hosted translation-server",
      "translator coverage varies by source",
      "does not prove source truth or preserve a page snapshot",
      "public metadata path requires no third-party token"
    ],
    "operation_kinds": [
      "network_metadata_read"
    ],
    "artifact_output": [
      "json"
    ]
  },
  "io": {
