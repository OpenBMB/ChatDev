{
  "manifest_version": "1.0",
  "resource_id": "tool.docx2text.v1",
  "resource_type": "Tool",
  "status": "active",
  "capability": {
    "summary": "Extract nonblank body paragraphs and table cell text from one DOCX into JSON",
    "execution_semantics": {
      "determinism": "deterministic",
      "side_effects": "none",
      "effect_targets": []
    },
    "description": "Opens one existing DOCX with python-docx, joins nonblank top-level document paragraphs with newline characters, and separately returns each table as nested table/row/cell text arrays. The operation is read-only and does not preserve document layout or paragraph/table interleaving.",
    "core_primitives": [
      "extract_nonblank_docx_body_paragraphs",
      "extract_docx_table_cell_text",
      "serialize_docx_text_as_json"
    ],
    "problem_space": "Basic text extraction from DOCX body paragraphs and tables for downstream processing; not layout-preserving conversion, OCR, rich-text rendering, document editing, or complete extraction of every Word content part.",
    "domain_tags": [
      "document_processing",
      "file_io",
      "text_extraction"
    ]
  },
  "constraint": {
    "env_requirements": [
      "Python 3.x",
      "python-docx"
    ],
    "io_signature": "Input: one required existing .docx file path; output: JSON with nonblank body paragraph text, paragraph count, and separately nested table cell strings, or an explicit open/parse error.",
    "accepted_inputs": [
      "an existing, readable Office Open XML .docx document supported by python-docx"
    ],
    "output_shape": "Success: {status: \"success\", tool: \"python-docx\", target: string, paragraph_count: integer, text: string, tables: string[][][]}; paragraph_count counts only nonblank top-level document paragraphs, text joins them with `\\n`, and tables is indexed as table/row/cell. Missing path: {status: \"error\", message: string} and exit 2. Open or parse failure: {status: \"error\", tool: \"python-docx\", message: string} and exit 1. The declared required input is validated before dispatch; direct CLI invocation without it prints usage and exits 1.",
    "limitations": [
      "text excludes blank body paragraphs and table content; table strings are returned only in the separate tables array",
      "does not preserve the original interleaving of paragraphs and tables, formatting, styles, pagination, images, hyperlinks, or layout",
      "does not explicitly extract headers, footers, footnotes, comments, tracked-change semantics, text boxes, or embedded-object text",
      "loads and emits the document without an explicit timeout, size limit, or output truncation and never modifies the DOCX"
    ],
    "artifact_input": [
      "file_path"
    ],
    "artifact_output": [
      "json"
    ]
  },
  "io": {
    "input_contract": [
      {
        "name": "file_path",
        "kind": "str",
        "required": true,
        "extensions": [
          ".docx"
        ],
        "cli_position": 1
      }
    ],
    "output_contract": {
