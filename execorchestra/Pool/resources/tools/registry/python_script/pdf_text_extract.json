{
  "manifest_version": "v2",
  "resource_id": "tool.pdf_text_extract.v1",
  "resource_type": "Tool",
  "status": "active",
  "capability": {
    "summary": "Extract complete text for an explicit page range from a text-bearing PDF.",
    "description": "Uses pdfplumber to return ordered per-page text for the full document or a caller-selected inclusive page range without silently truncating the selected range.",
    "domain_tags": [
      "document-processing",
      "pdf",
      "text-extraction"
    ],
    "core_primitives": [
      "extract_complete_pdf_text_range"
    ],
    "operation_kinds": [
      "extract_complete_pdf_text_range"
    ],
    "problem_space": "Deterministic text extraction from all or selected PDF pages for downstream search, reasoning, and exact-answer generation.",
    "execution_semantics": {
      "determinism": "deterministic",
      "side_effects": "none",
      "effect_targets": [],
      "modalities": [
        "document",
        "text"
      ]
    }
  },
  "constraint": {
    "io_signature": "Input: PDF path plus optional 1-based inclusive start_page and end_page. Output: typed JSON containing every selected page's complete extracted text.",
    "accepted_inputs": [
      "a readable text-bearing PDF supported by pdfplumber",
      "an optional valid page range"
    ],
    "artifact_input": [
      "pdf",
      "file"
    ],
    "artifact_output": [
      "json",
      "text"
    ],
    "output_shape": "Success contains page_count, selected range, range_complete=true, and ordered pages [{page,text}]. Invalid ranges or unreadable PDFs return a typed error envelope and non-zero exit.",
    "limitations": [
      "does not perform OCR, so image-only pages usually return empty text",
      "does not preserve layout, coordinates, images, or table structure",
      "large selected ranges can produce large JSON results; callers should select a narrower range when task evidence permits"
    ]
  },
  "io": {
    "input_contract": [
      {
        "name": "pdf_path",
        "kind": "file_path",
        "artifact_types": [
          "pdf"
        ],
        "extensions": [
          ".pdf"
        ],
        "required": true,
        "cli_position": 1
      },
      {
        "name": "start_page",
        "kind": "integer",
        "required": false,
        "cli_position": 2
      },
      {
        "name": "end_page",
        "kind": "integer",
        "required": false,
        "cli_position": 3
      }
    ],
    "output_contract": {
      "artifact_type": "json",
      "description": "Complete per-page text for the requested inclusive PDF page range.",
      "json_schema": {
        "oneOf": [
          {
            "type": "object",
