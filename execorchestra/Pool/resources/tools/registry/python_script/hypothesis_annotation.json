{
  "manifest_version": "v2",
  "resource_id": "tool.hypothesis_annotation.v1",
  "resource_type": "Tool",
  "status": "active",
  "capability": {
    "summary": "Create a source-linked Hypothesis annotation with quote and position selectors",
    "description": "SGAR adapter over upstream Hypothesis annotation API. It preserves source URI and TextQuoteSelector fields; no quote extraction or annotation semantics are implemented by SGAR.",
    "domain_tags": [
      "research",
      "evidence",
      "provenance"
    ],
    "core_primitives": [
      "bind_annotation_to_source_uri",
      "record_text_quote_selector",
      "return_annotation_metadata"
    ],
    "problem_space": "Evidence-fragment location and annotation metadata for a source URI; not web search, webpage capture, citation normalization, or cryptographic snapshotting."
  },
  "constraint": {
    "io_signature": "Input source URI, exact quote and optional prefix/suffix; output upstream annotation JSON.",
    "accepted_inputs": [
      "source URI and evidence quote"
    ],
    "output_shape": "JSON annotation receipt with target selectors and upstream identifiers.",
    "limitations": [
      "requires a reachable Hypothesis-compatible service",
      "hosted Hypothesis writes may require an API token",
      "local/self-hosted read-only or anonymous policy is deployment-specific",
      "does not itself hash or archive source content"
    ],
    "operation_kinds": [
      "network_annotation_write"
    ],
    "artifact_output": [
      "json"
    ]
  },
  "io": {
    "input_contract": [
      {
        "name": "uri",
        "kind": "string",
        "required": true,
        "cli_position": 1
      },
      {
        "name": "quote",
        "kind": "string",
        "required": false
      }
    ],
    "output_contract": {
      "artifact_type": "json",
      "description": "Source-linked annotation and selector receipt.",
      "json_schema": {
        "description": "Native JSON representation only; no field or task-delivery guarantee.",
        "type": [
          "object",
          "array",
          "string",
          "number",
          "boolean",
          "null"
        ]
      },
      "native_json_contract_scope": "value_only"
    }
  },
  "routing": {
    "family": "evidence-quote-location",
    "intent_tags": [
