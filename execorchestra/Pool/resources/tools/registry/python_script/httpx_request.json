{
  "manifest_version": "v2",
  "resource_id": "tool.httpx_request.v1",
  "resource_type": "Tool",
  "status": "active",
  "capability": {
    "summary": "Perform a bounded read-only HTTP request with HTTPX 0.28.1",
    "description": "Thin SGAR adapter over upstream HTTPX for GET or HEAD requests with explicit timeout, redirect, public-host and response-size controls.",
    "domain_tags": [
      "web",
      "http",
      "retrieval"
    ],
    "core_primitives": [
      "http_get_or_head",
      "capture_http_response",
      "bound_response_size"
    ],
    "problem_space": "Low-level retrieval of a caller-specified public HTTP(S) URL; not web search, browser automation, authentication workflows, uploads, or mutation."
  },
  "constraint": {
    "io_signature": "Input method GET|HEAD, public http(s) URL and optional bounds; output JSON status, final URL, status code, headers, decoded body, and redirect chain.",
    "accepted_inputs": [
      "absolute public HTTP or HTTPS URL",
      "GET or HEAD method"
    ],
    "output_shape": "JSON response envelope with bounded body text and redirect chain or explicit error.",
    "limitations": [
      "denies private, loopback, link-local, and reserved resolved addresses by default",
      "allows only GET and HEAD",
      "maximum response body is 10 MB",
      "does not provide search, HTML extraction, browser execution, credentials, proxy controls, uploads, or arbitrary headers"
    ],
    "operation_kinds": [
      "network_read"
    ],
    "artifact_output": [
      "json"
    ]
  },
  "io": {
    "input_contract": [
      {
        "name": "method",
        "kind": "string",
        "required": true,
        "values": [
          "GET",
          "HEAD"
        ],
        "cli_position": 1
      },
      {
        "name": "url",
        "kind": "string",
        "required": true,
        "cli_position": 2,
        "description": "Complete HTTP(S) URL as a plain string, without Markdown or surrounding quotes; obtain it from task input or observed discovery and preserve required source/date parameters."
      },
      {
        "name": "timeout_ms",
        "kind": "integer",
        "required": false,
        "cli_flag": "--timeout-ms",
        "default": 15000,
        "minimum": 1,
        "maximum": 120000,
        "description": "Request timeout in milliseconds."
      },
      {
        "name": "max_bytes",
        "kind": "integer",
        "required": false,
        "cli_flag": "--max-bytes",
        "default": 1000000,
        "minimum": 1,
        "maximum": 10000000,
        "description": "Maximum response body bytes; increase when response_too_large is observed."
      },
      {
        "name": "follow_redirects",
        "kind": "boolean",
        "required": false,
        "cli_flag": "--follow-redirects",
        "cli_value_mode": "flag",
        "default": false,
        "description": "Follow HTTP redirects when true."
      }
    ],
    "output_contract": {
      "artifact_type": "json",
      "description": "Returns HTTP status, headers and bounded UTF-8 body; this is response text, not a rendered page or parsed facts. Follow redirects only when requested. Failed responses are not source evidence.",
