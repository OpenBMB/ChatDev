      {
        "name": "sql",
        "kind": "string",
        "required": true,
        "cli_position": 1
      }
    ],
    "output_contract": {
      "artifact_type": "json",
      "description": "Bounded read-only DuckDB query result.",
      "json_schema": {
        "description": "Native JSON representation only; no field or task-delivery guarantee.",
        "type": [
          "object",
          "array",
          "string",
          "number",
          "boolean",
          "null"
        ]
      },
      "native_json_contract_scope": "value_only"
    }
  },
