  "resource_type": "Tool",
  "status": "active",
  "capability": {
    "summary": "Run bounded read-only analytical SQL with DuckDB 1.5.5",
    "description": "Thin SGAR adapter over upstream DuckDB using an in-memory database, fixed memory/thread bounds and a deny policy for mutation, extension installation and remote access.",
    "domain_tags": [
      "data",
      "sql",
      "analytics"
    ],
    "core_primitives": [
      "execute_analytical_sql",
      "query_local_tabular_data",
      "return_bounded_rows"
    ],
    "problem_space": "Read-only analytical SQL and local tabular inspection; not database mutation, persistent database management, extension loading, remote SQL, or arbitrary filesystem access."
  },
  "constraint": {
    "io_signature": "Input SQL, explicit local input_refs and max_rows; output columns, bounded rows, count and truncation flag.",
    "accepted_inputs": [
      "read-only analytical SQL",
      "explicit existing local input files"
    ],
    "output_shape": "JSON columns and rows or explicit policy/query error.",
    "limitations": [
      "denies DDL, DML, ATTACH, COPY, INSTALL, LOAD, PRAGMA, SET and remote URLs",
      "in-memory database only",
      "256 MB memory and two threads",
      "maximum 10000 returned rows"
    ],
    "operation_kinds": [
      "local_read",
      "analytical_query"
    ],
    "artifact_input": [
      "file_path"
    ],
    "artifact_output": [
      "json"
    ]
  },
  "io": {
